# Токен вашего Telegram-бота (от @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Ваш личный Telegram ID (можно узнать командой /id или у @userinfobot)
# Пока стоит 0, команда /start подскажет ваш ID
ADMIN_ID=0

# Cookies из браузера на сайте playerok.com (вкладка Network -> Cookie)
PLAYEROK_COOKIES=

# Либо только cookie-токен (если не указываете полную строку PLAYEROK_COOKIES)
PLAYEROK_TOKEN=

# Опциональный HTTP/HTTPS прокси для защиты аккаунта (например: http://user:pass@1.2.3.4:8080)
PROXY_URL=

# Путь к базе данных SQLite и баннеру меню
DB_PATH=data/mrloone_bot.db
BANNER_PATH=assets/banner.png

# Интервал опроса новых заказов (в секундах)
POLL_INTERVAL_MIN=5
POLL_INTERVAL_MAX=10

# Тестовый режим без реальных запросов к Playerok (true / false)
MOCK_MODE=false
